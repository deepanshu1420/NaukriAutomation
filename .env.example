# ============================================================
#  Naukri Profile Refresh Configuration
# ============================================================

# Google account (used for automatic Naukri sign-in when required)
GOOGLE_EMAIL=you@gmail.com
GOOGLE_PASSWORD=your-google-password

# Naukri profile URL (used to access your profile for automatic refresh)
NAUKRI_PROFILE_URL=https://www.naukri.com/mnjuser/profile

# Basic identity (used to validate configuration)
NAME=Your Name
EMAIL=you@gmail.com


# ============================================================
#  Auto-Apply Configuration (Optional)
#  Fill this section only if you use the Auto-Apply feature.
# ============================================================

# --- Contact ---
PHONE=+91 9999999999
LOCATION=City, Country

# --- Professional Profile ---
CURRENT_ROLE=Your Title at YourCompany (City)
COMPANY=YourCompany
EDUCATION=Your Degree, Your Institute (2020-2024)
YEARS_EXPERIENCE=X years professional plus internships
SKILLS=JavaScript, TypeScript, Python, React, Node.js, FastAPI, MongoDB, PostgreSQL, Docker, GCP

# Up to 5 resume highlights (separate using ||)
HIGHLIGHTS=First achievement||Second achievement||Third achievement||Fourth achievement||Fifth achievement

# --- Application Details ---
NOTICE_PERIOD=30 days
CURRENT_CTC=0
EXPECTED_CTC=0
DOB=DD/MM/YYYY
GENDER=Prefer not to say
WORK_AUTH=Authorized to work in my country of residence.

# --- Links ---
GITHUB_URL=https://github.com/yourhandle
LINKEDIN_URL=https://www.linkedin.com/in/yourhandle/
PORTFOLIO_URL=https://yourportfolio.com/

# --- Optional ---
# Gemini API key used only for answering application questions
GEMINI_KEY=YOUR_GEMINI_API_KEY